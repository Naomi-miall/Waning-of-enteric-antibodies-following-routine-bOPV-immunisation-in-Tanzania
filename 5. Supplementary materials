**# Supplement 7 - Forrest plot using detectable
*Detectable for sensitivity analysis
use "Both_datasets_long_ee", clear
keep if sampletype==2
bysort pid: egen pv1_any_detect_stool = max(pv1_stool_detectable)
bysort pid: egen pv3_any_detect_stool = max(pv3_stool_detectable)
sort pid visit
list pid visit pv1_stool_detectable pv1_any_detect_stool pv1_stool_responses in 1/50, sepby(pid)
list pid visit pv3_stool_detectable pv3_any_detect_stool pv3_stool_responses in 1/50, sepby(pid)
keep if visit==1

postfile handle str20 pv str20 outcome coef pval ci_low ci_high using results_temp.dta, replace

foreach x in bf_4months watersource_bin stunting hiv_exposure coinfect_enteroinvasive coinfect_otherbacteria coinfect_virus EE_bin {
	logistic pv1_any_detect_stool `x' ageweek, or
	local b = exp(_b[`x'])
    local ci_l = exp(_b[`x'] - 1.96 * _se[`x'])
    local ci_h = exp(_b[`x'] + 1.96 * _se[`x'])
	testparm `x'
	local p = r(p)
	post handle ("pv1") ("`x'") (`b') (`p') (`ci_l') (`ci_h')
	
	logistic pv3_any_detect_stool `x' ageweek, or
	local b = exp(_b[`x'])
    local ci_l = exp(_b[`x'] - 1.96 * _se[`x'])
    local ci_h = exp(_b[`x'] + 1.96 * _se[`x'])
	testparm `x'
	local p = r(p)
	post handle ("pv3") ("`x'") (`b') (`p') (`ci_l') (`ci_h')
} //type 3 has no variation within coinfect_caa - none of the pv3 positive were schisto positive.
foreach x in coinfect_caa {
	logistic pv1_any_detect_stool `x' ageweek, or
	local b = exp(_b[`x'])
    local ci_l = exp(_b[`x'] - 1.96 * _se[`x'])
    local ci_h = exp(_b[`x'] + 1.96 * _se[`x'])
	testparm `x'
	local p = r(p)
	post handle ("pv1") ("`x'") (`b') (`p') (`ci_l') (`ci_h')
}
postclose handle
